{
  "name": "lading",
  "version": "0.4.0",
  "description": "Archive broker for agents on TOON. One channel, several storage networks (Arweave, Walrus, Filecoin), every leg answers with the network's own receipt or buys nothing, and a signed bill of lading named on ArNS.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lading": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "fund:filecoin": "tsx src/filecoin-fund.ts",
    "test": "node --test --import tsx src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ar.io/sdk": "^4.1.4",
    "@filoz/synapse-sdk": "^2.0.0",
    "@solana/kit": "^2.1.0",
    "@toon-protocol/client": "^2.1.1",
    "@x402/evm": "^2.3.0",
    "@x402/fetch": "^2.3.0",
    "nostr-tools": "^2.10.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
