{
  "name": "lading",
  "version": "0.14.0",
  "description": "Archive broker for agents on TOON. One channel, several storage networks (Arweave, Walrus, Filecoin), every leg answers with the network's own receipt or buys nothing, and a signed bill of lading named on ArNS. Hosted behind an x402 door with an MCP shim for Claude.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lading": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "fund:filecoin": "tsx src/filecoin-fund.ts",
    "test": "node --test --import tsx src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate": "node dist/gate.js",
    "dev:gate": "tsx src/gate.ts",
    "extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@ar.io/sdk": "^4.1.4",
    "@filoz/synapse-sdk": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mysten/sui": "^2.29.0",
    "@mysten/walrus": "^1.2.23",
    "@solana/kit": "^2.1.0",
    "@toon-protocol/client": "^2.1.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.3.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.3.0",
    "express": "^5.2.1",
    "nostr-tools": "^2.10.4",
    "undici": "^8.10.2",
    "viem": "^2.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/*.mcpb",
    "!dist/extension.js",
    "!dist/extension.js.map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-dot-com/lading.git"
  },
  "homepage": "https://github.com/drew-dot-com/lading#readme",
  "keywords": [
    "toon",
    "ilp",
    "x402",
    "arweave",
    "walrus",
    "filecoin",
    "arns",
    "mcp",
    "archive"
  ]
}
