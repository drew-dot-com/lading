LADING_EVM_PRIVATE_KEY=0x...
# Filecoin Onchain Cloud key (any secp256k1 key; may be the same hex as the Base key). Needs a little FIL once, USDFC deposited via `npm run fund:filecoin`. Leave empty to keep the door off.
LADING_FILECOIN_PRIVATE_KEY=
LADING_FILECOIN_CHAIN=mainnet
LADING_FILECOIN_COPIES=2
LADING_FILECOIN_MIN_RUNWAY_DAYS=7
LADING_ANT_ID=BiW6dxwkphDjKWsDEqHRKMvNoTbebEDb5i83DUhTwsB1
LADING_ARNS_BASE_NAME=boughtviatoonnode
LADING_ARNS_GATEWAY=permagate.io
# Gateways tried in order for raw txid reads (verify, manifest fetch); the ArNS gateway always goes first. Names never fall back.
LADING_READ_GATEWAYS=permagate.io,arweave.net,ardrive.net
# ArNS name fallbacks: ONLY gateways whose /ar-io/info programIds equal the primary's (diff before adding). arweave.net does not qualify.
LADING_ARNS_GATEWAYS=ardrive.net,vilenarios.com
LADING_SOLANA_KEYPAIR=[1,2,3,...]
SOLANA_RPC=https://api.mainnet-beta.solana.com
